		{
			"id": "3U0Zz25u",
			"type": "text",
			"x": 160,
			"y": 840,
			"width": 800,
			"height": 150,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0u",
			"roundness": null,
			"seed": 1858297653,
			"version": 933,
			"versionNonce": 1414042805,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1792730520069,
			"created": 1792684705949,
			"locked": false,
			"text": "question 4: why start election timer after sending message to request votes?\nanswer 4: Timer measures how long you have been waiting for votes, not the time\nyou spent preparing to ask. \n\nMain reason - if the election fails, with a split vote or lost messages, the timer \nfiring is the only thing that triggers a retry with a new, higher term.",
			"rawText": "question 4: why start election timer after sending message to request votes?\nanswer 4: Timer measures how long you have been waiting for votes, not the time\nyou spent preparing to ask. \n\nMain reason - if the election fails, with a split vote or lost messages, the timer \nfiring is the only thing that triggers a retry with a new, higher term.",
			"fontSize": 20,
			"baseFontSize": null,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "question 4: why start election timer after sending message to request votes?\nanswer 4: Timer measures how long you have been waiting for votes, not the time\nyou spent preparing to ask. \n\nMain reason - if the election fails, with a split vote or lost messages, the timer \nfiring is the only thing that triggers a retry with a new, higher term.",
			"autoResize": false,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false
		},

		{
			"id": "pUMk7ABL",
			"type": "text",
			"x": -2100,
			"y": -40,
			"width": 800,
			"height": 175,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aM",
			"roundness": null,
			"seed": 75996277,
			"version": 692,
			"versionNonce": 1366859477,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1792698265574,
			"created": 1792667848043,
			"locked": false,
			"text": "1. All nodes start as a follower.\n2. Once randomized election timer times out, follower becomes candidate and\nrequest votes.\n3. once received enough votes, candidate becomes leader.\n4. if election times out, it remains candidate.\n5. if candidate finds a new term (new leader already elected), it becomes follower.\n6. if leader finds a new term (new leader elected), it becomes a follower.",
			"rawText": "1. All nodes start as a follower.\n2. Once randomized election timer times out, follower becomes candidate and request votes.\n3. once received enough votes, candidate becomes leader.\n4. if election times out, it remains candidate.\n5. if candidate finds a new term (new leader already elected), it becomes follower.\n6. if leader finds a new term (new leader elected), it becomes a follower.",
			"fontSize": 20,
			"baseFontSize": null,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "1. All nodes start as a follower.\n2. Once randomized election timer times out, follower becomes candidate and request votes.\n3. once received enough votes, candidate becomes leader.\n4. if election times out, it remains candidate.\n5. if candidate finds a new term (new leader already elected), it becomes follower.\n6. if leader finds a new term (new leader elected), it becomes a follower.",
			"autoResize": false,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false,
			"link": null
		},

		{
			"id": "QsuhkNmn",
			"type": "text",
			"x": 2136,
			"y": 3680,
			"width": 800,
			"height": 675,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": "g8pEYse9",
			"index": "b09",
			"roundness": null,
			"seed": 2108310581,
			"version": 894,
			"versionNonce": 614826421,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1792731249410,
			"created": 1792672723388,
			"locked": false,
			"text": "Raft (6/9) : Followers receiving messages\n\non receiving (LogRequest, leaderId, term, prefixLen, prefixterm, leaderCommit,\nsuffix) at node nodeId do\n\n    if term > currentTerm then\n        currentTerm := term\n        votedFor := null\n        cancel election timer\n    end if\n\n    if term = currentTerm then\n        currentRole := follower\n        currentLeader := leaderId\n    end if\n\n    logOk := (log.length ≥ prefixLen) ∧ (prefixLen = 0 ∨ log[prefixLen - 1].term =\nprefixTerm) \n\n    if term = currentTerm ∧ logOk then\n        APPENDENTRIES(prefixLen, leaderCommit, suffix)\n        ack := prefixLen + suffix.length\n        send(LogResponse, nodeId, currentTerm, ack, true) to leaderId\n    else \n        send(LogResponse, nodeId, currentTerm, 0, false) to leaderId\n    end if\nend on",
			"rawText": "Raft (6/9) : Followers receiving messages\n\non receiving (LogRequest, leaderId, term, prefixLen, prefixterm, leaderCommit, suffix) at node nodeId do\n\n    if term > currentTerm then\n        currentTerm := term\n        votedFor := null\n        cancel election timer\n    end if\n\n    if term = currentTerm then\n        currentRole := follower\n        currentLeader := leaderId\n    end if\n\n    logOk := (log.length ≥ prefixLen) ∧ (prefixLen = 0 ∨ log[prefixLen - 1].term = prefixTerm) \n\n    if term = currentTerm ∧ logOk then\n        APPENDENTRIES(prefixLen, leaderCommit, suffix)\n        ack := prefixLen + suffix.length\n        send(LogResponse, nodeId, currentTerm, ack, true) to leaderId\n    else \n        send(LogResponse, nodeId, currentTerm, 0, false) to leaderId\n    end if\nend on",
			"fontSize": 20,
			"baseFontSize": null,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Raft (6/9) : Followers receiving messages\n\non receiving (LogRequest, leaderId, term, prefixLen, prefixterm, leaderCommit, suffix) at node nodeId do\n\n    if term > currentTerm then\n        currentTerm := term\n        votedFor := null\n        cancel election timer\n    end if\n\n    if term = currentTerm then\n        currentRole := follower\n        currentLeader := leaderId\n    end if\n\n    logOk := (log.length ≥ prefixLen) ∧ (prefixLen = 0 ∨ log[prefixLen - 1].term = prefixTerm) \n\n    if term = currentTerm ∧ logOk then\n        APPENDENTRIES(prefixLen, leaderCommit, suffix)\n        ack := prefixLen + suffix.length\n        send(LogResponse, nodeId, currentTerm, ack, true) to leaderId\n    else \n        send(LogResponse, nodeId, currentTerm, 0, false) to leaderId\n    end if\nend on",
			"autoResize": false,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false
		},

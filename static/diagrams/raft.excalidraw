		{
			"id": "zF7LD3xw",
			"type": "text",
			"x": 1940,
			"y": 1260,
			"width": 677.9794921875,
			"height": 475,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": "NVHsrH5g",
			"index": "b0J",
			"roundness": null,
			"seed": 1487479707,
			"version": 668,
			"versionNonce": 934047957,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1792675412962,
			"created": 1792675237238,
			"locked": false,
			"text": "Raft (8/9) : leader receiving log acknowledgements\n\non receiving (LogRepsonse, follower, term, ack, success) at nodeId do\n    if term = currentTerm AND currentRole = leader then\n        if success = true AND ack >= ackedLength[follower] then\n            sentLength[follower] := ack\n            ackedLength[follower] := ack\n            COMMITLOGENTRIES()\n        else if sentLength[follower] > 0 then\n            sentLength[follower] := sentLength[follower] - 1\n            REPLICATELOG(nodeId, follower)\n        end if\n    else if term > currentTerm then\n        currentTerm := term\n        currentRole := follower\n        votedFor := null\n        cancel election timer\n    end if\nend on",
			"rawText": "Raft (8/9) : leader receiving log acknowledgements\n\non receiving (LogRepsonse, follower, term, ack, success) at nodeId do\n    if term = currentTerm AND currentRole = leader then\n        if success = true AND ack >= ackedLength[follower] then\n            sentLength[follower] := ack\n            ackedLength[follower] := ack\n            COMMITLOGENTRIES()\n        else if sentLength[follower] > 0 then\n            sentLength[follower] := sentLength[follower] - 1\n            REPLICATELOG(nodeId, follower)\n        end if\n    else if term > currentTerm then\n        currentTerm := term\n        currentRole := follower\n        votedFor := null\n        cancel election timer\n    end if\nend on",
			"fontSize": 20,
			"baseFontSize": null,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Raft (8/9) : leader receiving log acknowledgements\n\non receiving (LogRepsonse, follower, term, ack, success) at nodeId do\n    if term = currentTerm AND currentRole = leader then\n        if success = true AND ack >= ackedLength[follower] then\n            sentLength[follower] := ack\n            ackedLength[follower] := ack\n            COMMITLOGENTRIES()\n        else if sentLength[follower] > 0 then\n            sentLength[follower] := sentLength[follower] - 1\n            REPLICATELOG(nodeId, follower)\n        end if\n    else if term > currentTerm then\n        currentTerm := term\n        currentRole := follower\n        votedFor := null\n        cancel election timer\n    end if\nend on",
			"autoResize": true,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false
		},
		{
			"id": "NVHsrH5g",
			"type": "frame",
			"x": 1924,

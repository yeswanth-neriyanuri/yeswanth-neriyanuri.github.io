		{
			"id": "P5T54yPC",
			"type": "text",
			"x": 920,
			"y": 1200,
			"width": 764.259521484375,
			"height": 600,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": "ObsTiPQ6",
			"index": "b0L",
			"roundness": null,
			"seed": 1742903413,
			"version": 675,
			"versionNonce": 822616411,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1792675863490,
			"created": 1792675717342,
			"locked": false,
			"text": "Raft (9/9) : Leader committing log entries \n\nAny log entries that have been acknowledged by a quorum of nodes are ready \nto be committed by the leader.\nWhen a log entry is committed, it's message is delivered to the application.\n\n\nfunction COMMITLOGENTIRES\n    while commitLength < log.length do\n        acks := 0\n        for each node BELGONGS to nodes do\n            if ackedLength[node] > commitLength then\n                acks := acks + 1\n            end if\n        end for\n        \n        if acks >= [(|nodes| + 1 / 2)] then\n            deliver log[commitLength].msg to the application\n            commitLength := commitLength + 1\n        else \n            break\n        end if\n    end while\nend function",
			"rawText": "Raft (9/9) : Leader committing log entries \n\nAny log entries that have been acknowledged by a quorum of nodes are ready \nto be committed by the leader.\nWhen a log entry is committed, it's message is delivered to the application.\n\n\nfunction COMMITLOGENTIRES\n    while commitLength < log.length do\n        acks := 0\n        for each node BELGONGS to nodes do\n            if ackedLength[node] > commitLength then\n                acks := acks + 1\n            end if\n        end for\n        \n        if acks >= [(|nodes| + 1 / 2)] then\n            deliver log[commitLength].msg to the application\n            commitLength := commitLength + 1\n        else \n            break\n        end if\n    end while\nend function",
			"fontSize": 20,
			"baseFontSize": null,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Raft (9/9) : Leader committing log entries \n\nAny log entries that have been acknowledged by a quorum of nodes are ready \nto be committed by the leader.\nWhen a log entry is committed, it's message is delivered to the application.\n\n\nfunction COMMITLOGENTIRES\n    while commitLength < log.length do\n        acks := 0\n        for each node BELGONGS to nodes do\n            if ackedLength[node] > commitLength then\n                acks := acks + 1\n            end if\n        end for\n        \n        if acks >= [(|nodes| + 1 / 2)] then\n            deliver log[commitLength].msg to the application\n            commitLength := commitLength + 1\n        else \n            break\n        end if\n    end while\nend function",
			"autoResize": true,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false
		},
